#define IDI_APPICON 1

IDI_APPICON ICON "corvus.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Corvus Capture"
            VALUE "FileDescription",  "Corvus Capture \x2014 hotkey screenshot utility"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "CorvusCapture"
            VALUE "OriginalFilename", "CorvusCapture.exe"
            VALUE "ProductName",      "Corvus Capture"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
